# .env.example — copy to .env.local and fill in. .env.local is gitignored; never commit real values.
#
# Supabase project (Dashboard → Project Settings → API / API Keys).
# Both are PUBLIC by design: they ship to the browser. What they can do is limited by
# database permissions and Row Level Security, not by keeping them secret.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# NEVER put the secret / service_role key here or in any NEXT_PUBLIC_ variable.
